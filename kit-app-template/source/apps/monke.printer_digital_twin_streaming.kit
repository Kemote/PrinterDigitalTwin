[package]
title = "Printer Digital Twin Streaming"
version = "0.1.0"
description = "Configuration for streaming deployments of Printer Digital Twin"
keywords = ["experience", "app", "dev", "streaming"]
template_name = "omni.streaming_configuration"

[dependencies]
"monke.printer_digital_twin" = {}  # Application kit file
"omni.kit.livestream.app" = {}  # Livestream extension
"omni.services.livestream.webrtc" = {}

[settings.app]
fastShutdown = true
name = "Printer Digital Twin Streaming"  # Application Display Name
renderer.resolution.height = 1080
renderer.resolution.width = 1920
window.height = 1080
window.width = 1920

[settings]
exts.omni.kit.livestream.app".primaryStream.streamType="webrtc"
exts.omni.kit.livestream.app".primaryStream.signalPort=49100
exts.omni.services.transport.server.http:.port=8011
rtx.verifyDriverVersion.enabled = false

[settings.app.extensions]
registryEnabled = true
supportedTargets.platform = []  # Skip checking supported platform/config when building

exclude = [
    "omni.kit.developer.bundle",
    "omni.kit.widget.cache_indicator",
]

[settings.app.exts]
folders.'++' = [  # Search paths for extensions.
    "${app}/../exts",
    "${app}/../apps",
    "${app}/../extscache"
]

[settings.app.file]
ignoreUnsavedOnExit = true

[template]
type = "ApplicationLayerTemplate" # Repo Template Metadata


